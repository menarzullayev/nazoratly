 "parse_delimited": [
  {
   "name": "comma",
   "in": {
    "text": "ism,telefon\nAli,901234567\nVali,931112233\n"
   },
   "out": [
    [
     "ism",
     "telefon"
    ],
    [
     "Ali",
     "901234567"
    ],
    [
     "Vali",
     "931112233"
    ]
   ]
  },
  {
   "name": "semicolon",
   "in": {
    "text": "ism;telefon\nAli;901234567\n"
   },
   "out": [
    [
     "ism",
     "telefon"
    ],
    [
     "Ali",
     "901234567"
    ]
   ]
  },
  {
   "name": "tab",
   "in": {
    "text": "ism\ttelefon\nAli\t901234567\n"
   },
   "out": [
    [
     "ism",
     "telefon"
    ],
    [
     "Ali",
     "901234567"
    ]
   ]
  },
  {
   "name": "bom and CRLF",
   "in": {
    "text": "﻿ism,telefon\r\nAli,901234567\r\n"
   },
   "out": [
    [
     "ism",
     "telefon"
    ],
    [
     "Ali",
     "901234567"
    ]
   ]
  },
  {
   "name": "quoted comma",
   "in": {
    "text": "ism,izoh\n\"Aliyev, Ali\",\"a \"\"quoted\"\" word\"\n"
   },
   "out": [
    [
     "ism",
     "izoh"
    ],
    [
     "Aliyev, Ali",
     "a \"quoted\" word"
    ]
   ]
  },
  {
   "name": "quoted newline",
   "in": {
    "text": "ism,izoh\nAli,\"line1\nline2\"\n"
   },
   "out": [
    [
     "ism",
     "izoh"
    ],
    [
     "Ali",
     "line1\nline2"
    ]
   ]
  },
  {
   "name": "blank rows dropped",
   "in": {
    "text": "ism,telefon\n\nAli,901234567\n , \n\nVali,931112233"
   },
   "out": [
    [
     "ism",
     "telefon"
    ],
    [
     "Ali",
     "901234567"
    ],
    [
     "Vali",
     "931112233"
    ]
   ]
  },
  {
   "name": "no trailing newline",
   "in": {
    "text": "a,b\n1,2"
   },
   "out": [
    [
     "a",
     "b"
    ],
    [
     "1",
     "2"
    ]
   ]
  },
  {
   "name": "semicolon inside quotes does not decide",
   "in": {
    "text": "a,b\n\"x;y;z;w\",2\n"
   },
   "out": [
    [
     "a",
     "b"
    ],
    [
     "x;y;z;w",
     "2"
    ]
   ]
  },
  {
   "name": "empty",
   "in": {
    "text": ""
   },
   "out": []
  },
  {
   "name": "spaces trimmed",
   "in": {
    "text": "a , b\n 1 ,2 \n"
   },
   "out": [
    [
     "a",
     "b"
    ],
    [
     "1",
     "2"
    ]
   ]
  },
  {
   "name": "short row kept as is",
   "in": {
    "text": "a,b,c\n1,2\n"
   },
   "out": [
    [
     "a",
     "b",
     "c"
    ],
    [
     "1",
     "2"
    ]
   ]
  }
 ],
