    {"name": "context mode without scope falls to the parent", "in": {"explicit": null, "scope": null, "parent": 3, "default": 1, "mode": "context"}, "out": 3},
    {"name": "context mode with nothing else uses the default branch", "in": {"explicit": null, "scope": null, "parent": null, "default": 1, "mode": "context"}, "out": 1},
    {"name": "parent mode: the parent beats the scope", "in": {"explicit": null, "scope": 2, "parent": 3, "default": 1, "mode": "parent"}, "out": 3},
