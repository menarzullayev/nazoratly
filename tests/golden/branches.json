  "row_visible": [
    {"name": "center-wide staff sees every branch", "in": {"scope": null, "branch": 3, "shared": false}, "out": true},
    {"name": "center-wide staff sees unmarked rows", "in": {"scope": null, "branch": null, "shared": false}, "out": true},
    {"name": "restricted staff sees its own branch", "in": {"scope": 2, "branch": 2, "shared": false}, "out": true},
    {"name": "restricted staff does not see another branch", "in": {"scope": 2, "branch": 3, "shared": false}, "out": false},
