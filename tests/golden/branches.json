    {"name": "only target-branch enrollments: nothing to end, nothing blocks", "in": {"from": 1, "to": 2, "to_status": "active", "enrollment_branches": [2], "end_enrollments": false}, "out": {"ok": true, "error": null, "end_count": 0}}
