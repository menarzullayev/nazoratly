  "branch_totals": [
    {
      "name": "two branches, one empty",
      "in": {
        "branches": [{"id": 1, "name": "Asosiy"}, {"id": 2, "name": "Chilonzor"}, {"id": 3, "name": "Yunusobod"}],
        "facts": [
          {"branch": 1, "kind": "payment", "amount": "500000", "voided": false},
          {"branch": 1, "kind": "payment", "amount": "300000", "voided": false},
          {"branch": 1, "kind": "charge", "amount": "1000000", "voided": false},
          {"branch": 1, "kind": "expense", "amount": "200000", "voided": false},
          {"branch": 2, "kind": "payment", "amount": "150000", "voided": false},
          {"branch": 2, "kind": "charge", "amount": "400000", "voided": false}
        ]
      },
      "out": {
        "rows": [
          {"branch": 1, "revenue": "800000", "charges": "1000000", "expenses": "200000", "net": "600000"},
          {"branch": 2, "revenue": "150000", "charges": "400000", "expenses": "0", "net": "150000"},
          {"branch": 3, "revenue": "0", "charges": "0", "expenses": "0", "net": "0"}
        ],
        "unassigned": null,
        "total": {"revenue": "950000", "charges": "1400000", "expenses": "200000", "net": "750000"}
      }
    },
    {
      "name": "voided facts are ignored",
      "in": {
        "branches": [{"id": 1, "name": "Asosiy"}],
        "facts": [
          {"branch": 1, "kind": "payment", "amount": "100000", "voided": false},
          {"branch": 1, "kind": "payment", "amount": "999999", "voided": true},
          {"branch": 1, "kind": "expense", "amount": "5000", "voided": true}
        ]
      },
      "out": {
        "rows": [{"branch": 1, "revenue": "100000", "charges": "0", "expenses": "0", "net": "100000"}],
        "unassigned": null,
        "total": {"revenue": "100000", "charges": "0", "expenses": "0", "net": "100000"}
      }
    },
    {
      "name": "a fact of an unknown or missing branch is shown as unassigned and still counted in the total",
      "in": {
        "branches": [{"id": 1, "name": "Asosiy"}],
        "facts": [
          {"branch": 1, "kind": "payment", "amount": "100000", "voided": false},
          {"branch": null, "kind": "payment", "amount": "40000", "voided": false},
          {"branch": 9, "kind": "expense", "amount": "10000", "voided": false}
        ]
      },
      "out": {
        "rows": [{"branch": 1, "revenue": "100000", "charges": "0", "expenses": "0", "net": "100000"}],
        "unassigned": {"revenue": "40000", "charges": "0", "expenses": "10000", "net": "30000"},
        "total": {"revenue": "140000", "charges": "0", "expenses": "10000", "net": "130000"}
      }
    },
    {
      "name": "expenses above revenue give a negative net",
      "in": {
        "branches": [{"id": 4, "name": "Sergeli"}],
        "facts": [
          {"branch": 4, "kind": "payment", "amount": "100000", "voided": false},
          {"branch": 4, "kind": "expense", "amount": "350000", "voided": false}
        ]
      },
      "out": {
        "rows": [{"branch": 4, "revenue": "100000", "charges": "0", "expenses": "350000", "net": "-250000"}],
        "unassigned": null,
        "total": {"revenue": "100000", "charges": "0", "expenses": "350000", "net": "-250000"}
      }
    },
    {
      "name": "no facts at all",
      "in": {"branches": [{"id": 1, "name": "Asosiy"}, {"id": 2, "name": "Chilonzor"}], "facts": []},
      "out": {
        "rows": [
          {"branch": 1, "revenue": "0", "charges": "0", "expenses": "0", "net": "0"},
          {"branch": 2, "revenue": "0", "charges": "0", "expenses": "0", "net": "0"}
        ],
        "unassigned": null,
        "total": {"revenue": "0", "charges": "0", "expenses": "0", "net": "0"}
      }
    }
  ],
