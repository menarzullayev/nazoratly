{
  "name": "nazoratly-sheets",
  "version": "0.1.0",
  "private": true,
  "description": "nazoratly for Google Sheets: Apps Script (TypeScript) with Telegram notifications",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "push": "npm run build && clasp push"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.15",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
