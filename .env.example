# Copy to .env and fill in (never commit .env). Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
NAZORATLY_APP_PASSWORD=
NAZORATLY_AUTH_PASSWORD=
NAZORATLY_AGENT_PASSWORD=
NAZORATLY_WORKER_PASSWORD=
NAZORATLY_JWT_SECRET=
# Fernet key that encrypts Payme/Click secrets, Telegram bot tokens and relay secrets at rest (api and worker):  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NAZORATLY_SECRETS_KEY=
# optional: the shared Telegram bot (guardians and teachers). After filling these in, register it once:
#   docker compose exec api python -m nazoratly.telegram_setup shared
NAZORATLY_TELEGRAM_BOT_TOKEN=
# the public https address of this server (bot webhooks, Mini App, portal link), e.g. https://nazoratly.example.uz
# It is also the staff panel's origin: empty = the panel's sign-in routes (/v1/auth/web/*) are closed.
NAZORATLY_PUBLIC_BASE_URL=
# Telegram webhook relay for the Sheets edition (Apps Script answers POST with a redirect Telegram cannot follow).
# This is the single connection of /hooks/telegram; more connections: python -m nazoratly.relays add (docs/DEPLOY.md)
NAZORATLY_TG_RELAY_TARGET=
NAZORATLY_TG_RELAY_SECRET=
# username of the shared bot without @ (used for invitation links until the bot is registered)
NAZORATLY_TELEGRAM_BOT_USERNAME=
NAZORATLY_TEACHER_REMINDER_INTERVAL_S=300
# AI assistant (optional): URL of the host-side worker, e.g. http://host.docker.internal:8765, and its shared token (16+ chars).
# Empty = no AI, reports are rule-based. The worker itself runs on the host: python -m nazoratly.ai_host_worker
NAZORATLY_AI_WORKER_URL=
NAZORATLY_AI_WORKER_TOKEN=
NAZORATLY_AI_MODEL=haiku
# SMS via Eskiz.uz (leave empty until you have an account; SMS then fails with a clear reason)
NAZORATLY_ESKIZ_EMAIL=
NAZORATLY_ESKIZ_PASSWORD=
NAZORATLY_ESKIZ_FROM=4546
NAZORATLY_MCP_ALLOWED_HOSTS=[]
NAZORATLY_CORS_ORIGINS=[]
NAZORATLY_SENTRY_DSN=
NAZORATLY_OTEL_EXPORTER_OTLP_ENDPOINT=
# host ports (127.0.0.1 only; publish through a TLS proxy / Cloudflare tunnel)
NAZORATLY_API_PORT=8000
NAZORATLY_MCP_PORT=8001
NAZORATLY_PANEL_PORT=8013
# prod behind a proxy/tunnel: NAZORATLY_ENV=prod and NAZORATLY_TRUST_PROXY_HEADERS=true
# header the trusted proxy overwrites with the real client address (single address, never an appended list)
NAZORATLY_CLIENT_IP_HEADER=cf-connecting-ip

# landing: public "make a copy" link of the demo Google Sheet (docs/DEMO.md); empty = the button is hidden. Baked into the site at build time
NEXT_PUBLIC_DEMO_SHEET_COPY_URL=
