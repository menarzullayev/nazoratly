{
  "name": "@nazoratly/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client generated from the nazoratly OpenAPI document",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
